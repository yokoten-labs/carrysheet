{
  "schema": 1,
  "title": "What a cell displays versus the value it holds",
  "formats": ["xlsx", "xls"],
  "cases": [
    {
      "id": "disp.general-third",
      "note": "General shows a limited number of digits of 1/3; the value keeps all of them. Compare value and text.",
      "formulas": { "A1": "=1/3", "A2": "=2/3" }
    },
    {
      "id": "disp.general-large",
      "note": "General switches large numbers to scientific notation at some length.",
      "formulas": { "A1": "=123456789012", "A2": "=1234567890123", "A3": "=999999999999999", "A4": "=1E+15" }
    },
    {
      "id": "disp.general-small",
      "note": "General shows small numbers in scientific notation at some point.",
      "formulas": { "A1": "=0.0000123456789", "A2": "=0.001", "A3": "=-1/3*1E-20" }
    },
    {
      "id": "disp.general-binary-sum",
      "note": "0.1+0.2 displays as 0.3 in General even though the double is 0.30000000000000004.",
      "formulas": { "A1": "=0.1+0.2" }
    },
    {
      "id": "disp.two-decimals-2-005",
      "note": "2.005 is 2.00499999... as a double; with 0.00 does the display round to 2.01 (decimal) or 2.00 (binary)?",
      "formulas": { "A1": { "f": "=2.005", "format": "0.00" } }
    },
    {
      "id": "disp.two-decimals-1-005",
      "note": "Same question for 1.005.",
      "formulas": { "A1": { "f": "=1.005", "format": "0.00" }, "A2": { "f": "=1.115", "format": "0.00" } }
    },
    {
      "id": "disp.no-decimals-half",
      "note": "Display rounding of halves with format 0: half away from zero, also for negatives.",
      "formulas": {
        "A1": { "f": "=2.5", "format": "0" },
        "A2": { "f": "=-2.5", "format": "0" },
        "A3": { "f": "=0.5", "format": "0" }
      }
    },
    {
      "id": "disp.negative-tiny",
      "note": "-0.0001 with 0.00: does the minus sign stay (-0.00)?",
      "formulas": { "A1": { "f": "=-0.0001", "format": "0.00" } }
    },
    {
      "id": "disp.many-decimals",
      "note": "With 21 decimals Excel shows only 15 significant digits and pads with zeros.",
      "formulas": {
        "A1": { "f": "=0.1", "format": "0.000000000000000000000" },
        "A2": { "f": "=0.1+0.2", "format": "0.000000000000000000000" },
        "A3": { "f": "=1/3", "format": "0.000000000000000000000" }
      }
    },
    {
      "id": "disp.near-zero-scientific",
      "note": "A near-zero result in scientific format shows whether it was snapped.",
      "formulas": { "A1": { "f": "=1*(0.5-0.4-0.1)", "format": "0.00E+00" } }
    },
    {
      "id": "disp.percent",
      "note": "0.125 as 0% displays 13%; 0.0049 displays 0%.",
      "formulas": { "A1": { "f": "=0.125", "format": "0%" }, "A2": { "f": "=0.0049", "format": "0%" } }
    },
    {
      "id": "disp.fraction",
      "note": "Fraction formats pick the nearest fraction with the allowed digits.",
      "formulas": {
        "A1": { "f": "=1/3", "format": "# ?/?" },
        "A2": { "f": "=0.3333", "format": "# ??/??" },
        "A3": { "f": "=2.75", "format": "# ?/?" }
      }
    },
    {
      "id": "disp.thousands",
      "note": "Thousands separators and scaling by a trailing comma.",
      "formulas": {
        "A1": { "f": "=1234567.891", "format": "#,##0.00" },
        "A2": { "f": "=1234567", "format": "#,##0," }
      }
    },
    {
      "id": "disp.hidden",
      "note": "The format ;;; hides the value: the text is empty but the value is 42.",
      "formulas": { "A1": { "f": "=42", "format": ";;;" } },
      "expect": { "A1": 42 }
    },
    {
      "id": "disp.sections",
      "note": "Three-section formats choose by sign; zero gets its own text.",
      "formulas": {
        "A1": { "f": "=-5", "format": "0;(0);\"zero\"" },
        "A2": { "f": "=0", "format": "0;(0);\"zero\"" },
        "A3": { "f": "=-0.4", "format": "0;(0);\"zero\"" }
      }
    },
    {
      "id": "disp.text-format-on-number",
      "note": "The @ format on a formula that returns a number: the value stays a number.",
      "formulas": { "A1": { "f": "=5", "format": "@" } },
      "expect": { "A1": 5 }
    },
    {
      "id": "disp.narrow-column-number",
      "note": "A number that does not fit shows ####; the value is unchanged.",
      "columnWidths": { "A": 3 },
      "formulas": { "A1": { "f": "=123456", "format": "0" } },
      "expect": { "A1": 123456 }
    },
    {
      "id": "disp.narrow-column-general",
      "note": "In a narrow column General shortens decimals instead of showing ####.",
      "columnWidths": { "A": 4 },
      "formulas": { "A1": "=1/3", "A2": "=123456" }
    },
    {
      "id": "disp.time-am-pm",
      "note": "0.75 as h:mm AM/PM is 6:00 PM; the AM/PM text may follow the Excel language.",
      "formulas": { "A1": { "f": "=0.75", "format": "h:mm AM/PM" } }
    },
    {
      "id": "disp.short-date-builtin",
      "note": "m/d/yyyy is the built-in short date (format 14), which displays in the Windows short date order of the machine.",
      "formulas": { "A1": { "f": "=45292", "format": "m/d/yyyy" } }
    },
    {
      "id": "disp.text-function-vs-display",
      "note": "TEXT(2.005,\"0.00\") compared with the displayed text of 2.005 formatted 0.00.",
      "formulas": { "A1": "=TEXT(2.005,\"0.00\")", "A2": "=TEXT(1/3,\"General\")" }
    },
    {
      "id": "disp.fixed-function",
      "note": "FIXED rounds and adds thousands separators.",
      "formulas": { "A1": "=FIXED(1234.5678,2)", "A2": "=FIXED(1234.5678,-2)", "A3": "=FIXED(1234.5678,2,TRUE)" }
    },
    {
      "id": "disp.dollar-function",
      "note": "DOLLAR uses the currency symbol and format of the locale.",
      "formulas": { "A1": "=DOLLAR(1234.5)", "A2": "=DOLLAR(-1234.5)" }
    },
    {
      "id": "disp.exponent-format",
      "note": "Scientific format with two decimals.",
      "formulas": { "A1": { "f": "=123456", "format": "0.00E+00" }, "A2": { "f": "=0.000123456", "format": "0.00E+00" } }
    },
    {
      "id": "disp.color-section",
      "note": "A colour section does not change the text, only the colour.",
      "formulas": { "A1": { "f": "=-3", "format": "0;[Red]-0" } }
    },
    {
      "id": "disp.text-section",
      "note": "A fourth section formats text results.",
      "formulas": { "A1": { "f": "=\"abc\"", "format": "0;-0;0;\"<\"@\">\"" } }
    },
    {
      "id": "disp.boolean-and-error-display",
      "note": "Booleans and errors display the same whatever the number format.",
      "formulas": { "A1": { "f": "=TRUE", "format": "0.00" }, "A2": { "f": "=1/0", "format": "0.00" } }
    }
  ]
}
