+/// An element read by [`parse`] written back as XML (Carrysheet patch: keeps elements GridCraft
+/// does not model). Names are local, so this suits elements of the part's default namespace
+/// whose attributes have no prefix, except `xml:space`, which is written back. An element holds
+/// either text or children (mixed content is not kept in the tree).
+pub fn write_el(e: &El, out: &mut String) {
+    out.push('<');
+    out.push_str(&e.name);
+    for (k, v) in &e.attrs {
+        out.push(' ');
+        if k == "space" {
+            out.push_str("xml:");
+        }
+        out.push_str(k);
+        out.push_str("=\"");
+        out.push_str(&esc_attr(v));
+        out.push('"');
+    }
+    if e.children.is_empty() && e.text.is_empty() {
+        out.push_str("/>");
+        return;
+    }
+    out.push('>');
+    for c in &e.children {
+        write_el(c, out);
+    }
+    out.push_str(&esc(&e.text));
+    out.push_str("</");
+    out.push_str(&e.name);
+    out.push('>');
+}
