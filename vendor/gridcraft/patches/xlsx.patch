+use gridcraft_model::{Formula, Workbook};
+
+thread_local! {
+    /// While a workbook is written: the functions it read with a `_xlfn.` prefix that GridCraft
+    /// has no file name for, by upper-case name, with that prefix (Carrysheet patch).
+    static UNKNOWN_PREFIXED: RefCell<HashMap<String, String>> = RefCell::new(HashMap::new());
+}
+
+/// Functions in formula text read from a file that carry Excel's `_xlfn.` prefix but that
+/// GridCraft would write without it: (upper-case name, prefix as written).
+pub fn unknown_prefixed(text: &str) -> Vec<(String, String)> {
+    let mut out = vec![];
+    let lower = text.to_ascii_lowercase();
+    let mut from = 0;
+    while let Some(i) = lower.get(from..).and_then(|s| s.find("_xlfn.")) {
+        let start = from + i;
+        let mut name_at = start + 6;
+        if lower.get(name_at..).is_some_and(|s| s.starts_with("_xlws.")) {
+            name_at += 6;
+        }
+        let end = text
+            .get(name_at..)
+            .map_or(name_at, |s| name_at + s.find(|c: char| !(c.is_ascii_alphanumeric() || c == '_' || c == '.')).unwrap_or(s.len()));
+        let name = text.get(name_at..end).unwrap_or("").to_ascii_uppercase();
+        let called = text.get(end..).is_some_and(|s| s.trim_start().starts_with('('));
+        let builtin = matches!(name.as_str(), "ANCHORARRAY" | "SINGLE") || name.starts_with("_TRO_");
+        if called && !name.is_empty() && !builtin && crate::tables::file_function_name(&name).is_none() {
+            out.push((name, text.get(start..name_at).unwrap_or("_xlfn.").to_string()));
+        }
+        from = end.max(start + 6);
+    }
+    out
+}
+
+/// Runs `f` with the workbook's kept `_xlfn.` functions known to [`to_file`] (Carrysheet patch).
+pub fn with_kept_prefixes<T>(wb: &Workbook, f: impl FnOnce() -> T) -> T {
+    let kept: HashMap<String, String> = wb
+        .preserved
+        .as_deref()
+        .map(|p| p.elements.iter().filter_map(|e| Some((e.slot.strip_prefix("xlfn:")?.to_string(), e.xml.clone()))).collect())
+        .unwrap_or_default();
+    UNKNOWN_PREFIXED.with(|m| *m.borrow_mut() = kept);
+    let out = f();
+    UNKNOWN_PREFIXED.with(|m| m.borrow_mut().clear());
+    out
+}
 
