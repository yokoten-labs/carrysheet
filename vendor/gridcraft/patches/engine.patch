 /// Recomputes an automatic row height from its content: the largest font, and wrapped or
 /// multi-line text. Rows with a user-set height keep it.
+/// The start of a cell's text that decides its row's height: a row is at most 409 points tall,
+/// so text past Excel's 32,767 characters never shows (Carrysheet patch: a 20 MB text shared by
+/// 100,000 cells was searched in full for each cell).
+fn shown_part(text: &str) -> &str {
+    const SHOWN: usize = 32_767 * 4;
+    if text.len() <= SHOWN {
+        return text;
+    }
+    let mut end = SHOWN;
+    while !text.is_char_boundary(end) {
+        end -= 1;
+    }
+    text.get(..end).unwrap_or(text)
+}
